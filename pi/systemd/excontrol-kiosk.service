[Unit]
Description=eXcontrol local display (cage + Chromium kiosk on tty1)
Wants=excontrol.service
After=excontrol.service systemd-user-sessions.service plymouth-quit-wait.service
# Take tty1 over from the login prompt.
Conflicts=getty@tty1.service
After=getty@tty1.service
StartLimitIntervalSec=0

[Service]
User=@USER@
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
UtmpIdentifier=tty1
UtmpMode=user
Environment=EXCONTROL_DATA_DIR=@DATA_DIR@
# Once per boot, as root (+): re-enumerate USB touch panels — a software replug (see the script).
ExecStartPre=+@APP_DIR@/pi/touch-reset.sh
ExecStart=@APP_DIR@/pi/kiosk.sh
Restart=always
RestartSec=3
RestartSteps=5
RestartMaxDelaySec=30

[Install]
WantedBy=multi-user.target
