[Unit]
Description=eXcontrol backend
Wants=network-online.target
After=network-online.target
# An appliance never gives up restarting (systemd's default: stop after 5 starts in 10 s).
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
WorkingDirectory=@APP_DIR@
Environment=EXCONTROL_DATA_DIR=@DATA_DIR@
ExecStart=/usr/bin/node @APP_DIR@/backend/dist/cli.js
Restart=always
# 2 s, growing to 30 s while it keeps failing (systemd >= 254)
RestartSec=2
RestartSteps=5
RestartMaxDelaySec=30
# cli.ts caps its own graceful stop at 5 s; this is the backstop.
TimeoutStopSec=15

# --- sandbox (systemd-analyze security: 9.2 UNSAFE before) ---
# The backend only needs to read its code, write its data dir, and talk TCP/UDP on the LAN.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@DATA_DIR@
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RemoveIPC=yes
# netlink: os.networkInterfaces() for the setup wizard's network scan
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
